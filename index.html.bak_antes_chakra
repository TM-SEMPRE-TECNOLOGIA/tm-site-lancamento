<script>
/**
 * HIGH-PERFORMANCE CANVAS FRAME RENDERER (60 FPS INSTANT SCRUBBING)
 * Zero decodificação de vídeo em tempo de execução: resposta imediata ao scroll em mobile e desktop.
 */
(function() {
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d', { alpha: false });
  const progressBar = document.getElementById('progress');
  const chapters = [...document.querySelectorAll('.chapter')];

  const TOTAL_FRAMES = 150;
  const images = new Array(TOTAL_FRAMES);
  let loadedCount = 0;
  let currentRenderedIndex = -1;
  let animFrameId = 0;

  // 1. Redimensionamento do Canvas mantendo a proporção exata da tela
  function resizeCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    currentRenderedIndex = -1; // força re-desenho
    renderFrame(getCurrentFrameIndex());
  }

  // 2. Renderização em Proporção 'cover' (centralizado e sem distorção)
  function renderFrame(index) {
    if (index === currentRenderedIndex) return;
    const img = images[index];
    if (!img || !img.complete || img.naturalWidth === 0) return;

    currentRenderedIndex = index;
    const cw = canvas.width;
    const ch = canvas.height;
    const iw = img.naturalWidth;
    const ih = img.naturalHeight;

    const scale = Math.max(cw / iw, ch / ih);
    const sw = iw * scale;
    const sh = ih * scale;
    const sx = (cw - sw) / 2;
    const sy = (ch - sh) / 2;

    ctx.drawImage(img, 0, 0, iw, ih, sx, sy, sw, sh);
  }

  // Calcula a distância de scroll exata onde a narrativa de vídeo acontece
  function getVideoScrollRange() {
    const storyEl = document.querySelector('.story');
    const footerEl = document.querySelector('.footer');
    const targetEnd = footerEl || storyEl;
    if (!targetEnd) {
      return Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    }
    // O vídeo completa 100% exatamente quando o último capítulo / footer é atingido
    const endOffset = targetEnd.offsetTop + targetEnd.offsetHeight - window.innerHeight;
    return Math.max(1, endOffset);
  }

  function getCurrentFrameIndex() {
    const videoRange = getVideoScrollRange();
    const progress = Math.max(0, Math.min(1, window.scrollY / videoRange));
    if (progressBar) {
      progressBar.style.width = (progress * 100) + '%';
    }
    return Math.min(TOTAL_FRAMES - 1, Math.max(0, Math.floor(progress * TOTAL_FRAMES)));
  }

  function update() {
    renderFrame(getCurrentFrameIndex());
    animFrameId = 0;
  }

  function requestUpdate() {
    if (!animFrameId) {
      animFrameId = requestAnimationFrame(update);
    }
  }

  // 3. Pré-carregamento Inteligente e Progressivo
  // Carrega o primeiro frame imediatamente para pintar a tela instantaneamente
  const firstImg = new Image();
  firstImg.src = 'frames/frame_000.jpg';
  firstImg.onload = () => {
    images[0] = firstImg;
    renderFrame(0);
  };

  // Carrega o restante em segundo plano
  for (let i = 0; i < TOTAL_FRAMES; i++) {
    const num = String(i).padStart(3, '0');
    const img = new Image();
    img.src = `frames/frame_${num}.jpg`;
    img.onload = () => {
      images[i] = img;
      loadedCount++;
      if (i === getCurrentFrameIndex()) {
        renderFrame(i);
      }
    };
  }

  // 5. Parallax Suave da Plataforma de Lançamento (Opção 2)
  const platformImg = document.getElementById('parallax-platform');
  function updatePlatformParallax() {
    if (!platformImg) return;
    const rect = platformImg.getBoundingClientRect();
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      const scrollProgress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
      const moveY = (scrollProgress - 0.5) * 35; // deslocamento sutil de 35px
      platformImg.style.transform = `translate3d(0, ${moveY.toFixed(1)}px, 0)`;
    }
  }

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', resizeCanvas, { passive: true });
  window.addEventListener('orientationchange', resizeCanvas, { passive: true });

  // 4. Observer de Capítulos (Fade in/out dos textos no scroll)
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      entry.target.classList.toggle('active', entry.isIntersecting);
    });
  }, { threshold: 0.38 });

  chapters.forEach(ch => observer.observe(ch));

  // Inicialização
  resizeCanvas();
})();

/**
 * ════════════════════════════════════════════════════════════════════
 * THREE.JS 3D CYLINDRICAL MOTION CAROUSEL (EXACT JESPER CLONE ENGINE)
 * ════════════════════════════════════════════════════════════════════
 */
(function init3DCarousel() {
  const container = document.getElementById('carousel-webgl-stage');
  const progressBar = document.getElementById('carousel-progress-fill');
  if (!container || typeof THREE === 'undefined') return;

  const PROJECTS = [
    { id: "cat-dev", title: "Sistemas & Pipelines de Dados", category: "Fullstack Architecture", image: "assets/cards/card_1.jpg", aspect: 16 / 9 },
    { id: "robot-spark", title: "Agentes Autônomos & Workflows", category: "Agentic AI & LLMs", image: "assets/cards/card_2.jpg", aspect: 16 / 9 },
    { id: "duck-debug", title: "Plataformas Web de Alto Desempenho", category: "Next.js & Cloud", image: "assets/cards/card_3.jpg", aspect: 16 / 9 },
    { id: "astronaut-chill", title: "Dashboards & Gestão em Tempo Real", category: "Operação Digital", image: "assets/cards/card_4.jpg", aspect: 16 / 9 },
    { id: "cyber-helmet", title: "Automação de Processos Críticos", category: "Ganho de +85% Eficiência", image: "assets/cards/card_5.jpg", aspect: 16 / 9 },
    { id: "coffee-compile", title: "Engenharia & Arquitetura Digital", category: "Reverse Engine", image: "assets/cards/card_6.jpg", aspect: 16 / 9 },
    { id: "drone-labs", title: "Interfaces Cinemáticas & 3D Web", category: "UI/UX & WebGL", image: "assets/cards/card_7.jpg", aspect: 16 / 9 },
    { id: "cactus-cook", title: "APIs Resilientes & Microsserviços", category: "Backend & Infraestrutura", image: "assets/cards/card_8.jpg", aspect: 16 / 9 }
  ];

  let scene, camera, renderer;
  let cardMeshes = [];
  let gridHelper;
  let textureLoader = new THREE.TextureLoader();

  let targetScroll = 0;
  let currentScroll = 0;
  let scrollVelocity = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let dragStartX = 0;
  let dragStartY = 0;
  let isIntersecting = false;

  // Efeito Padrão de Alta Definição
  const config = {
    cylinderRadius: 10.0,
    cardSpacing: 5.2,
    damping: 0.020,
    shaderType: 0, // 0: Kinetic Wave / Liquid Distortion
    intensity: 0.8, // 80%
    showGrid: true,
    cardBaseHeight: 2.8,
  };

  const vertexShader = `
    uniform float uTime;
    uniform float uVelocity;
    uniform float uRadius;
    uniform int uShaderType;
    uniform float uIntensity;
    uniform float uHover;
    uniform int uIsMobile;

    varying vec2 vUv;
    varying vec3 vNormal;
    varying float vDistortion;

    void main() {
      vUv = uv;
      vNormal = normal;

      vec3 pos = position;

      // 1. Curvatura Cilíndrica profunda
      if (uIsMobile == 1) {
        float arc = pos.y / uRadius;
        pos.z -= (1.0 - cos(arc)) * uRadius;
        pos.y = sin(arc) * uRadius;
      } else {
        float arc = pos.x / uRadius;
        pos.z -= (1.0 - cos(arc)) * uRadius;
        pos.x = sin(arc) * uRadius;
      }

      float distVal = 0.0;

      // 2. Deformações por Shader Mode (Kinetic Wave)
      if (uShaderType == 0) {
        float wave = sin((uIsMobile == 1 ? vUv.x : vUv.y) * 6.28 + uTime * 3.0 + (uIsMobile == 1 ? pos.y : pos.x)) * (abs(uVelocity) * 1.8 + 0.05 * uHover) * uIntensity;
        pos.z += wave;
        distVal = wave;
      }

      // Hover scale suave
      pos.z += uHover * 0.35;

      vDistortion = distVal;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
  `;

  const fragmentShader = `
    uniform sampler2D uTexture;
    uniform float uVelocity;
    uniform float uTime;
    uniform int uShaderType;
    uniform float uIntensity;
    uniform float uHover;
    uniform float uAspect;

    varying vec2 vUv;
    varying vec3 vNormal;
    varying float vDistortion;

    // SDF para cantos arredondados perfeitos
    float roundedBox(vec2 p, vec2 b, float r) {
      vec2 q = abs(p) - b + r;
      return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
    }

    void main() {
      vec2 uv = vUv;

      // 1. Cálculo de Cantos Arredondados com Anti-aliasing
      vec2 p = uv - vec2(0.5);
      p.x *= uAspect;
      vec2 halfSize = vec2(0.5 * uAspect, 0.5);
      float cornerRadius = 0.048;
      float dist = roundedBox(p, halfSize, cornerRadius);
      
      float alpha = 1.0 - smoothstep(0.0, 0.005, dist);
      if (alpha < 0.02) discard;

      vec4 color = vec4(1.0);

      if (uShaderType == 0) {
        // Kinetic Wave + Liquid Distortion
        vec2 waveUv = uv;
        waveUv.x += sin(uv.y * 12.0 + uTime * 4.0) * (abs(uVelocity) * 0.08 + 0.015 * uHover) * uIntensity;
        waveUv.y += cos(uv.x * 12.0 + uTime * 4.0) * (abs(uVelocity) * 0.08 + 0.015 * uHover) * uIntensity;
        color = texture2D(uTexture, waveUv);
        color.rgb += vec3(0.85, 0.4, 0.15) * abs(sin(uv.y * 8.0 + uTime * 2.0)) * (abs(uVelocity) * 1.5 + uHover * 0.25) * uIntensity;
      } else {
        color = texture2D(uTexture, uv);
      }

      // Vinheta de borda e contraste editorial
      float vignette = smoothstep(0.85, 0.15, length(uv - vec2(0.5)));
      color.rgb *= mix(0.88, 1.05, vignette);

      // Borda luminosa alaranjada sutil (#d96526)
      float borderGlow = 1.0 - smoothstep(0.0, 0.009, abs(dist));
      color.rgb += vec3(0.85, 0.4, 0.15) * borderGlow * (0.35 + uHover * 0.5);

      // Hover highlight
      color.rgb += uHover * 0.08;

      gl_FragColor = vec4(color.rgb, alpha);
    }
  `;

  function isMobile() {
    return window.innerWidth < 768;
  }

  function init() {
    scene = new THREE.Scene();
    scene.background = null;
    scene.fog = new THREE.FogExp2(0x05070b, 0.028);

    const w = container.clientWidth || window.innerWidth;
    const h = container.clientHeight || window.innerHeight;

    const aspect = w / h;
    camera = new THREE.PerspectiveCamera(45, aspect, 0.1, 100);
    updateCameraPosition();

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputEncoding = THREE.sRGBEncoding;
    container.appendChild(renderer.domElement);

    createGridFloor();
    createCards();
    setupInteraction();
    animate();
  }

  function updateCameraPosition() {
    if (isMobile()) {
      camera.position.set(0, 0, 7.8);
      camera.lookAt(0, 0, 0);
    } else {
      camera.position.set(0, 0.2, 7.5);
      camera.lookAt(0, 0, 0);
    }
  }

  function createGridFloor() {
    const size = 60;
    const divisions = 60;
    gridHelper = new THREE.GridHelper(size, divisions, 0xd96526, 0x4a1e0b);
    gridHelper.material.opacity = 0.65;
    gridHelper.material.transparent = true;
    gridHelper.position.y = isMobile() ? -3.5 : -1.8;
    gridHelper.position.z = -5;
    scene.add(gridHelper);
  }

  function getCardDimensions(proj) {
    if (isMobile()) {
      const width = 3.6;
      const height = width / (proj.aspect || 1.6);
      return { width, height };
    } else {
      const height = config.cardBaseHeight;
      const width = height * (proj.aspect || 1.6);
      return { width, height };
    }
  }

  function createCards() {
    cardMeshes.forEach(m => scene.remove(m));
    cardMeshes = [];

    PROJECTS.forEach((proj, idx) => {
      const { width, height } = getCardDimensions(proj);
      const cardAspect = proj.aspect || (width / height);

      const geometry = new THREE.PlaneGeometry(width, height, 32, 16);

      const texture = textureLoader.load(proj.image, (tex) => {
        tex.generateMipmaps = true;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
      });

      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: {
          uTexture: { value: texture },
          uTime: { value: 0 },
          uVelocity: { value: 0 },
          uRadius: { value: isMobile() ? 14.0 : config.cylinderRadius },
          uShaderType: { value: config.shaderType },
          uIntensity: { value: config.intensity },
          uHover: { value: 0.0 },
          uIsMobile: { value: isMobile() ? 1 : 0 },
          uAspect: { value: cardAspect },
        },
        transparent: true,
        side: THREE.DoubleSide,
      });

      const mesh = new THREE.Mesh(geometry, material);
      mesh.userData = { id: proj.id, title: proj.title, index: idx, baseWidth: width, baseHeight: height };
      scene.add(mesh);
      cardMeshes.push(mesh);
    });
  }

  function updateCardPositions() {
    const totalCards = cardMeshes.length;
    const mobile = isMobile();

    if (mobile) {
      const spacing = 3.2;
      const totalHeight = totalCards * spacing;
      const radius = 14.0;

      cardMeshes.forEach((mesh, i) => {
        let yOffset = -(i * spacing - currentScroll) % totalHeight;
        if (yOffset < -totalHeight / 2) yOffset += totalHeight;
        if (yOffset > totalHeight / 2) yOffset -= totalHeight;

        mesh.position.x = 0;
        mesh.position.y = yOffset;

        const arc = yOffset / radius;
        mesh.position.z = -((1.0 - Math.cos(arc)) * radius);
        mesh.rotation.x = -arc;
        mesh.rotation.y = 0;

        if (mesh.material.uniforms) {
          mesh.material.uniforms.uVelocity.value = scrollVelocity;
          mesh.material.uniforms.uRadius.value = radius;
          mesh.material.uniforms.uShaderType.value = config.shaderType;
          mesh.material.uniforms.uIntensity.value = config.intensity;
          mesh.material.uniforms.uIsMobile.value = 1;
        }
      });

      if (progressBar) {
        const norm = Math.abs(currentScroll % totalHeight) / totalHeight;
        progressBar.style.width = (norm * 100).toFixed(1) + '%';
      }
    } else {
      const totalWidth = totalCards * config.cardSpacing;

      cardMeshes.forEach((mesh, i) => {
        let xOffset = (i * config.cardSpacing - currentScroll) % totalWidth;
        if (xOffset < -totalWidth / 2) xOffset += totalWidth;
        if (xOffset > totalWidth / 2) xOffset -= totalWidth;

        mesh.position.x = xOffset;
        mesh.position.y = 0;

        const arc = xOffset / config.cylinderRadius;
        mesh.position.z = -((1.0 - Math.cos(arc)) * config.cylinderRadius);
        mesh.rotation.x = 0;
        mesh.rotation.y = -arc;

        if (mesh.material.uniforms) {
          mesh.material.uniforms.uVelocity.value = scrollVelocity;
          mesh.material.uniforms.uRadius.value = config.cylinderRadius;
          mesh.material.uniforms.uShaderType.value = config.shaderType;
          mesh.material.uniforms.uIntensity.value = config.intensity;
          mesh.material.uniforms.uIsMobile.value = 0;
        }
      });

      if (progressBar) {
        const norm = Math.abs(currentScroll % totalWidth) / totalWidth;
        progressBar.style.width = (norm * 100).toFixed(1) + '%';
      }
    }
  }

  let clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    if (!isIntersecting) return;

    const elapsedTime = clock.getElapsedTime();

    const diff = targetScroll - currentScroll;
    currentScroll += diff * config.damping;
    scrollVelocity = diff * config.damping;

    updateCardPositions();

    cardMeshes.forEach(mesh => {
      if (mesh.material.uniforms) {
        mesh.material.uniforms.uTime.value = elapsedTime;
      }
    });

    renderer.render(scene, camera);
  }

  // Raycaster para Hover nos Cards
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();
  let hoveredMesh = null;

  function handleRaycastHover(e) {
    const rect = container.getBoundingClientRect();
    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObjects(cardMeshes);

    if (intersects.length > 0) {
      const mesh = intersects[0].object;
      if (hoveredMesh !== mesh) {
        if (hoveredMesh) resetMeshHover(hoveredMesh);
        hoveredMesh = mesh;
        animateMeshHover(mesh, 1.0);
      }
    } else {
      if (hoveredMesh) {
        resetMeshHover(hoveredMesh);
        hoveredMesh = null;
      }
    }
  }

  function animateMeshHover(mesh, val) {
    if (!mesh || !mesh.material.uniforms) return;
    gsap.to(mesh.material.uniforms.uHover, {
      value: val,
      duration: 0.35,
      ease: "power2.out"
    });
  }

  function resetMeshHover(mesh) {
    if (!mesh || !mesh.material.uniforms) return;
    gsap.to(mesh.material.uniforms.uHover, {
      value: 0.0,
      duration: 0.35,
      ease: "power2.out"
    });
  }

  let manualDragOffset = 0;

  function getPinScrollProgress() {
    const pinWrapper = document.getElementById('portfolio-pin-wrapper');
    if (!pinWrapper) return 0;
    const rect = pinWrapper.getBoundingClientRect();
    const totalDistance = pinWrapper.offsetHeight - window.innerHeight;
    if (totalDistance <= 0) return 0;
    const progress = Math.max(0, Math.min(1, -rect.top / totalDistance));
    return progress;
  }

  function updateScrollTarget() {
    const totalSpan = cardMeshes.length * (isMobile() ? 3.2 : config.cardSpacing);
    const pinProgress = getPinScrollProgress();
    
    // Se o usuário não está arrastando manualmente, o scroll da página guia o carrossel
    if (!isDragging) {
      targetScroll = (pinProgress * totalSpan) + manualDragOffset;
    }
  }

  function setupInteraction() {
    // 1. Scroll da Página sincronizado com a rotação dos 8 cards
    window.addEventListener('scroll', () => {
      if (isIntersecting) {
        updateScrollTarget();
      }
    }, { passive: true });

    // 2. Drag & Drop Manual (Mouse)
    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      dragStartX = targetScroll;
      dragStartY = targetScroll;
      container.classList.add('grabbing');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) {
        handleRaycastHover(e);
        return;
      }
      if (isMobile()) {
        const deltaY = e.clientY - startY;
        targetScroll = dragStartY + deltaY * 0.015;
      } else {
        const deltaX = e.clientX - startX;
        targetScroll = dragStartX - deltaX * 0.015;
      }
      const totalSpan = cardMeshes.length * (isMobile() ? 3.2 : config.cardSpacing);
      manualDragOffset = targetScroll - (getPinScrollProgress() * totalSpan);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        container.classList.remove('grabbing');
      }
    });

    // 3. Touch Support
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        dragStartX = targetScroll;
        dragStartY = targetScroll;
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        if (isMobile()) {
          const deltaY = e.touches[0].clientY - startY;
          targetScroll = dragStartY + deltaY * 0.015;
        } else {
          const deltaX = e.touches[0].clientX - startX;
          targetScroll = dragStartX - deltaX * 0.015;
        }
        const totalSpan = cardMeshes.length * (isMobile() ? 3.2 : config.cardSpacing);
        manualDragOffset = targetScroll - (getPinScrollProgress() * totalSpan);
      }
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDragging = false;
    });

    // 4. Resize
    window.addEventListener('resize', () => {
      if (!renderer || !camera) return;
      const w = container.clientWidth || window.innerWidth;
      const h = container.clientHeight || window.innerHeight;
      camera.aspect = w / h;
      updateCameraPosition();
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      createCards();
      updateScrollTarget();
    });

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          updateScrollTarget();
        }
      });
    }, { threshold: 0.02 });

    const pinWrapper = document.getElementById('portfolio-pin-wrapper');
    if (pinWrapper) {
      sectionObserver.observe(pinWrapper);
    }
  }

  init();
})();

/**
 * ════════════════════════════════════════════════════════════════════
 * VÍDEO EM LOOP VISUAL + WEB AUDIO API ENGINE (AUTO-PLAY AUTOMÁTICO NO SCROLL)
 * ════════════════════════════════════════════════════════════════════
 */
let globalSoundActive = true;

function toggleGlobalSound(e) {
  if (e) e.stopPropagation();
  globalSoundActive = !globalSoundActive;
  const label = document.getElementById('global-sound-label');
  const badge = document.querySelector('.sound-experience-badge');
  
  if (label) {
    label.textContent = globalSoundActive ? 'SOM: ATIVADO' : 'SOM: MUDO';
  }
  if (badge) {
    badge.style.opacity = globalSoundActive ? '1' : '0.5';
  }
}

(function initNeonWebAudioEngine() {
  const vid = document.getElementById('neon-name-video');
  const audio = document.getElementById('neon-audio-track');
  if (!vid) return;

  // Garante loop visual contínuo
  vid.muted = true;
  vid.loop = true;
  vid.play().catch(() => {});

  let audioHasPlayed = false;
  let audioCtx = null;
  let audioBuffer = null;
  const AudioCtx = window.AudioContext || window.webkitAudioContext;

  // 1. Pré-carrega o áudio diretamente na memória RAM (Web Audio API Buffer)
  if (AudioCtx) {
    try {
      audioCtx = new AudioCtx();
      fetch('meu-nome-neon.mp4')
        .then(res => res.arrayBuffer())
        .then(arrayBuffer => audioCtx.decodeAudioData(arrayBuffer))
        .then(decoded => {
          audioBuffer = decoded;
        })
        .catch(() => {});
    } catch(err) {}
  }

  // 2. Destrava o AudioContext em qualquer gesto
  function resumeCtx() {
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume().catch(() => {});
    }
  }

  ['pointerdown', 'mousedown', 'touchstart', 'click', 'keydown', 'scroll', 'wheel'].forEach(evt => {
    window.addEventListener(evt, resumeCtx, { passive: true });
  });

  // 3. Dispara o áudio de 4s
  function triggerAudioAuto(force = false) {
    if (!globalSoundActive) return;
    if (audioHasPlayed && !force) return;

    if (audioCtx && audioBuffer) {
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const source = audioCtx.createBufferSource();
      source.buffer = audioBuffer;
      source.connect(audioCtx.destination);
      source.start(0);
      audioHasPlayed = true;
    } else if (audio) {
      audio.currentTime = 0;
      audio.volume = 1.0;
      audio.play().then(() => {
        audioHasPlayed = true;
      }).catch(() => {});
    }
  }

  // Se o usuário clicar no vídeo do neon, toca o som imediatamente (mesmo se já tocou antes)
  vid.style.cursor = 'pointer';
  vid.addEventListener('click', () => {
    triggerAudioAuto(true);
  });

  // Monitora a dobra no scroll contínuo e com IntersectionObserver
  function checkScrollTrigger() {
    const rect = vid.getBoundingClientRect();
    if (rect.top < window.innerHeight * 0.75 && rect.bottom > 100) {
      triggerAudioAuto();
    }
  }

  window.addEventListener('scroll', checkScrollTrigger, { passive: true });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !audioHasPlayed) {
        triggerAudioAuto();
      }
    });
  }, { threshold: 0.15 });

  observer.observe(vid);
})();
</script>
