<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#05070b">
<title>Thiago Nascimento — Desenvolvimento Web & Inteligência Artificial</title>
<link rel="icon" type="image/x-icon" href="favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<!-- Three.js & GSAP para Carrossel 3D -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<style>
:root {
  --orange: #d96526;
  --orange-glow: rgba(217, 101, 38, 0.65);
  --ink: #05070b;
  --line: rgba(255, 255, 255, 0.14);
  --muted: rgba(255, 255, 255, 0.58);
  --faint: rgba(255, 255, 255, 0.32);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { background: var(--ink); scroll-behavior: smooth; }
body {
  background: var(--ink);
  color: #fff;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ── CANVAS CINEMATOGRÁFICO DE FUNDO (RESPOSTA INSTANTÂNEA EM DESKTOP E MOBILE) ── */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  object-fit: cover;
  pointer-events: none;
  background: var(--ink) url('hero-poster.jpg') center/cover no-repeat;
  filter: saturate(0.95) contrast(1.05);
  transform: translate3d(0,0,0);
}

/* ── OVERLAY DE CONTRASTE EDITORIAL ── */
#tone {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(3, 5, 9, 0.92) 0%, rgba(3, 5, 9, 0.44) 38%, rgba(3, 5, 9, 0.15) 65%, rgba(3, 5, 9, 0.55) 100%),
    linear-gradient(180deg, rgba(2, 4, 8, 0.52) 0%, transparent 32%, rgba(2, 4, 8, 0.85) 100%);
}
#tone::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 45%, transparent 0 30%, rgba(2, 4, 8, 0.28) 75%, rgba(2, 4, 8, 0.78) 100%);
}

/* ── BARRA DE PROGRESSO DO SCROLL ── */
#progress {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  height: 2px;
  width: 0%;
  background: var(--orange);
  box-shadow: 0 0 16px var(--orange-glow);
  transition: width 0.05s linear;
}

/* ── NAVEGAÇÃO DISCRETA ── */
.topbar {
  position: fixed;
  z-index: 10;
  top: 24px;
  left: clamp(24px, 6vw, 88px);
  right: clamp(24px, 6vw, 88px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
}
.brand {
  color: #fff;
  font-weight: 700;
  letter-spacing: 4px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity 0.3s;
}
.brand:hover { opacity: 0.85; }
.brand i { color: var(--orange); font-style: normal; }

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(16px, 3vw, 32px);
}
.nav-link {
  color: var(--muted);
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 2.5px;
  font-weight: 500;
  transition: color 0.3s;
  position: relative;
  padding: 4px 0;
}
.nav-link:hover, .nav-link.active {
  color: #fff;
}
.nav-link.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--orange);
  box-shadow: 0 0 8px var(--orange);
}

/* ── NARRATIVA DE SCROLL (HOME) ── */
.story {
  position: relative;
  z-index: 2;
}

.chapter {
  min-height: 160vh;
  position: relative;
  display: flex;
  align-items: center;
  padding: 10vh clamp(28px, 10vw, 150px);
}
.chapter:first-child {
  min-height: 100vh;
  align-items: flex-end;
  padding-bottom: 14vh;
}

.chapter-inner {
  width: min(560px, 100%);
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1), transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}
.chapter.active .chapter-inner {
  opacity: 1;
  transform: translateY(0);
}

.chapter.right {
  justify-content: flex-end;
  text-align: right;
}
.chapter.center {
  justify-content: center;
  text-align: center;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--orange);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin-bottom: 24px;
}
.right .eyebrow { justify-content: flex-end; }
.center .eyebrow { justify-content: center; }
.eyebrow::before {
  content: "";
  width: 36px;
  height: 1px;
  background: var(--orange);
  box-shadow: 0 0 10px var(--orange-glow);
}
.center .eyebrow::after {
  content: "";
  width: 36px;
  height: 1px;
  background: var(--orange);
  box-shadow: 0 0 10px var(--orange-glow);
}

h1, h2 {
  font-weight: 300;
  letter-spacing: -0.05em;
  line-height: 0.98;
}
h1 {
  font-size: clamp(44px, 7.5vw, 104px);
  text-transform: uppercase;
}
h2 {
  font-size: clamp(34px, 5.5vw, 76px);
}
h1 strong, h2 strong {
  color: var(--orange);
  font-weight: 800;
}

.metric-highlight {
  display: inline-block;
  color: var(--orange);
  font-size: clamp(48px, 8vw, 92px);
  font-weight: 800;
  letter-spacing: -0.06em;
  line-height: 0.9;
  margin-top: 14px;
  margin-bottom: 6px;
}

.lead {
  margin-top: 24px;
  max-width: 460px;
  color: var(--muted);
  font-size: clamp(14px, 1.4vw, 17px);
  line-height: 1.65;
  font-weight: 400;
}
.right .lead { margin-left: auto; }
.center .lead { margin-left: auto; margin-right: auto; }

.micro {
  margin-top: 28px;
  color: var(--faint);
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-family: 'JetBrains Mono', monospace;
}

.chapter-note {
  margin-top: 26px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  color: rgba(255, 255, 255, 0.42);
  font-size: 11px;
  line-height: 1.6;
  letter-spacing: 0.5px;
}

.scroll-cue {
  position: absolute;
  left: clamp(28px, 10vw, 150px);
  bottom: 34px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--faint);
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
}
.scroll-cue span {
  display: block;
  width: 32px;
  height: 1px;
  background: var(--faint);
}

/* ── SOUND EXPERIENCE MASTER BADGE ── */
.sound-experience-badge {
  position: fixed;
  top: 24px;
  right: 28px;
  z-index: 100;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: rgba(5, 7, 11, 0.85);
  border: 1px solid rgba(217, 101, 38, 0.45);
  border-radius: 999px;
  color: #fff;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  backdrop-filter: blur(16px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(217, 101, 38, 0.2);
  transition: all 0.3s ease;
  user-select: none;
}
.sound-experience-badge:hover {
  background: rgba(217, 101, 38, 0.25);
  border-color: #ff7733;
  box-shadow: 0 0 20px rgba(255, 119, 51, 0.5);
  transform: scale(1.04);
}

.sound-wave-icon {
  display: flex;
  align-items: center;
  gap: 2.5px;
  height: 12px;
}
.sound-wave-icon span {
  width: 2px;
  height: 100%;
  background: var(--orange);
  border-radius: 999px;
  animation: wave-bar 1.2s ease-in-out infinite;
}
.sound-wave-icon span:nth-child(2) { animation-delay: 0.2s; height: 60%; }
.sound-wave-icon span:nth-child(3) { animation-delay: 0.4s; height: 80%; }

@keyframes wave-bar {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1.0); }
}

/* ── MARQUEE BAND (TICKER DE DISPONIBILIDADE) ── */
.marquee-band {
  position: relative;
  z-index: 3;
  width: 100%;
  overflow: hidden;
  background: var(--orange);
  padding: 14px 0;
  cursor: default;
  user-select: none;
}

.marquee-band__track {
  display: flex;
  width: max-content;
  animation: marquee-scroll 38s linear infinite;
}

.marquee-band:hover .marquee-band__track {
  animation-play-state: paused;
}

@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.marquee-band__group {
  display: flex;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
}

.marquee-band__item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-family: 'JetBrains Mono', 'Inter', monospace;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  white-space: nowrap;
  padding: 0 8px;
}

.marquee-band__dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.6), 0 0 20px rgba(255, 255, 255, 0.25);
  animation: dot-pulse 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.85); }
}

.marquee-band__sep {
  color: #fff;
  font-size: 10px;
  padding: 0 16px;
  opacity: 0.65;
  flex-shrink: 0;
}

/* ── SEÇÃO 1: TRANSIÇÃO CINEMATOGRÁFICA EM VÍDEO NEON (FULL-WIDTH DE PONTA A PONTA) ── */
.section-laser-divider {
  position: relative;
  z-index: 3;
  width: 100%;
  padding: 0;
  margin: 0;
  background: #000;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.laser-line-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, rgba(217, 101, 38, 0.4) 20%, #ff7733 50%, rgba(217, 101, 38, 0.4) 80%, transparent 100%);
  box-shadow: 0 0 18px rgba(255, 119, 51, 0.75), 0 0 40px rgba(217, 101, 38, 0.45);
  z-index: 2;
}

/* Vídeo Full-Width de Ponta a Ponta */
.neon-video-frame {
  position: relative;
  width: 100%;
  width: 100vw;
  max-width: 100%;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: #000;
  aspect-ratio: 16 / 9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.neon-video-element {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── PINNED SCROLL WRAPPER (TRAVAMENTO DE SCROLL POR 1 CICLO COMPLETO) ── */
#portfolio-pin-wrapper {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 360vh; /* Altura ideal para percorrer os 8 cards suavemente */
  background: transparent;
}

#section-portfolio-3d {
  position: sticky;
  top: 0;
  z-index: 3;
  width: 100%;
  height: 100vh;
  background: var(--ink);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

#carousel-webgl-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  cursor: grab;
  touch-action: none;
  z-index: 1;
}

#carousel-webgl-stage.grabbing {
  cursor: grabbing !important;
}

/* Header & Footer do 3D Stage */
.stage-ui-header {
  position: relative;
  z-index: 10;
  padding: 32px clamp(24px, 6vw, 80px) 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
}
.stage-ui-title h3 {
  font-size: clamp(24px, 4vw, 44px);
  font-weight: 300;
  letter-spacing: -0.03em;
  color: #fff;
}
.stage-ui-title h3 strong {
  font-weight: 800;
  color: var(--orange);
}
.stage-ui-subtitle {
  color: var(--muted);
  font-size: 12px;
  letter-spacing: 2px;
  font-family: 'JetBrains Mono', monospace;
  text-transform: uppercase;
  margin-top: 6px;
}

.stage-ui-footer {
  position: relative;
  z-index: 10;
  padding: 0 clamp(24px, 6vw, 80px) 36px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.carousel-drag-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  margin: 0 auto;
}
.drag-hint-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.45);
}
.carousel-progress-track {
  width: 140px;
  height: 2px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999px;
  overflow: hidden;
}
.carousel-progress-thumb {
  height: 100%;
  width: 0%;
  background: var(--orange);
  box-shadow: 0 0 10px var(--orange-glow);
  transition: width 0.05s linear;
}



.slot-placeholder {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  border-bottom: 1px dashed rgba(255, 255, 255, 0.12);
}
.slot-label {
  color: rgba(255, 255, 255, 0.35);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 4px;
  text-transform: uppercase;
}

/* ── FOOTER EDITORIAL ── */
.footer {
  min-height: 75vh;
  display: flex;
  align-items: flex-end;
  padding: 8vh clamp(28px, 10vw, 150px) 10vh;
}
.footer .chapter-inner {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}
.footer-signature {
  color: rgba(255, 255, 255, 0.45);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.footer-signature strong {
  display: block;
  color: var(--orange);
  font-size: 18px;
  letter-spacing: 4px;
  margin-bottom: 6px;
}
.footer-links-inline {
  display: flex;
  gap: 20px;
  margin-top: 12px;
}
.footer-links-inline a {
  color: var(--muted);
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 2px;
  transition: color 0.2s;
}
.footer-links-inline a:hover { color: #fff; }
.footer-copy {
  color: var(--faint);
  font-size: 11px;
  letter-spacing: 1px;
}

/* ── RESPONSIVIDADE MOBILE ── */
@media (max-width: 768px) {
  #tone {
    background:
      linear-gradient(180deg, rgba(3, 5, 9, 0.45) 0%, rgba(3, 5, 9, 0.25) 30%, rgba(3, 5, 9, 0.90) 100%),
      linear-gradient(90deg, rgba(3, 5, 9, 0.65) 0%, transparent 85%);
  }
  .topbar { top: 18px; left: 20px; right: 20px; }
  .chapter, .chapter:first-child {
    min-height: 130vh;
    padding: 80px 24px 14vh;
    align-items: flex-end;
  }
  .chapter.right, .chapter.center {
    justify-content: flex-start;
    text-align: left;
  }
  .right .eyebrow, .center .eyebrow { justify-content: flex-start; }
  .center .eyebrow::after { display: none; }
  .right .lead, .center .lead { margin-left: 0; margin-right: 0; }
  h1 { font-size: clamp(40px, 13vw, 70px); }
  h2 { font-size: clamp(30px, 10vw, 54px); }
  .scroll-cue { left: 24px; bottom: 26px; }
  .footer { min-height: 60vh; padding: 70px 24px; }
  .footer .chapter-inner { display: block; }
  .footer-copy { margin-top: 24px; }
  .marquee-band { padding: 10px 0; }
  .marquee-band__item { font-size: 10px; letter-spacing: 2px; }
  .marquee-band__sep { padding: 0 12px; }
  .marquee-band__track { animation-duration: 28s; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .chapter-inner { transition: none; }
  .marquee-band__track { animation: none; }
  .marquee-band__dot { animation: none; }
}
</style>
</head>
